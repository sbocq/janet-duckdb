    "ieee_floating_point_ops" "Use IEEE 754 behavior for supported floating point operations, returning NAN/INF instead of errors/NULL."
    "ignore_unknown_crs" "Ignore unknown Coordinate Reference Systems (CRS) when creating geometry types or importing geospatial data."
    "immediate_transaction_mode" "Whether transactions should be started lazily when needed, or immediately when BEGIN TRANSACTION is called."
    "index_scan_max_count" "The maximum index scan count sets a threshold for index scans. If fewer than MAX(index_scan_max_count, index_scan_percentage * total_row_count) rows match, we perform an index scan instead of a table scan."
    "index_scan_percentage" "The index scan percentage sets a threshold for index scans. If fewer than MAX(index_scan_max_count, index_scan_percentage * total_row_count) rows match, we perform an index scan instead of a table scan."
    "initial_column_segment_size" "The initial memory (in bytes) reserved for the first transient column segment. Must be a power of two. Internally, we subtract the block header size (typically 8 bytes) for segments with or exceeding 1024 bytes. Subsequent segments double in size until reaching the block size."
    "integer_division" "Whether or not the / operator defaults to integer division, or to floating point division."
    "json_geometry_format" "json"
    "lambda_syntax" "Deprecated setting. Configures the use of the deprecated single arrow operator (->) for lambda functions."
    "late_materialization_max_rows" "The maximum amount of rows in the LIMIT/SAMPLE operator for which we trigger late materialization."
    "legacy_disable_null_type" "When enabled, prevent the NULL type from leaving the binder. This was the default behavior prior to DuckDB v2.0."
    "legacy_metrics_format" "Deprecated setting. When enabled, profiling output uses the legacy flat format instead of the current grouped format."
    "lock_configuration" "Whether configurations can be altered."
    "log_query_path" "Specifies the path to which queries should be logged. The default is NULL, meaning queries are not logged."
    "logging_level" "Determines which 'severity' of log messages will be logged."
    "logging_mode" "Determines which types of log messages are logged."
