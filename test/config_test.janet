    "azure_transport_option_type" "azure"
    "azure_write_block_size" "azure"
    "azure_write_staged_blocks_per_commit" "azure"
    "binary_as_string" "parquet"
    "block_allocator_memory" "Physical memory that the block allocator is allowed to use. This memory is allocated once, never freed, and cannot be reduced."
    "ca_cert_file" "httpfs"
    "cache_local_files" "Whether the external file cache also caches local files. Remote files are always cached."
    "calendar" "icu"
    "catalog_error_max_schemas" "The maximum number of schemas in the catalog that the system will scan to generate the \"did you mean...\" error message."
    "checkpoint_on_detach" "Override checkpoint behavior when detaching a database. ENABLED requests a checkpoint, but the checkpoint does not occur if another connection still references the database. DISABLED never checkpoints, DEFAULT defers to the global checkpoint_on_shutdown setting."
    "checkpoint_threshold" "The WAL size threshold at which to automatically trigger a checkpoint, e.g. 1GB."
    "current_dialect" "The SQL dialect used by the parser."
    "current_transaction_invalidation_policy" "Which types of exceptions invalidate the database for the current transaction."
    "custom_extension_repository" "Overrides the custom endpoint for extension installation."
    "custom_user_agent" "HTTP request metadata that can be set by callers/wrappers to tag their own traffic when DuckDB makes a request."
    "debug_abort_on_wal_failure" "Whether or not to abort if a serialization exception is thrown during WAL playback."
    "debug_asof_iejoin" "Force the use of an IEJoin to implement ASOF joins."
    "debug_checkpoint_abort" "Trigger an abort while checkpointing."
    "debug_checkpoint_scan_sleep_ms" "DEBUG SETTING: time to sleep after a checkpoint has written a table's row groups, before it installs them"
    "debug_checkpoint_sleep_ms" "Time to sleep before a checkpoint is invoked."
    "debug_delta_only_variant_encoding_enabled" "Enables the Parquet reader to identify a Variant structurally."
    "debug_disable_optimizer" "Disable running the optimizer."
    "debug_enable_caching_operators" "Enables caching operators that cache intermediate results."
    "debug_eviction_queue_sleep_micro_seconds" "Set a time for the eviction queue to sleep before acquiring the shared ownership of some block memory."
    "debug_force_bitpacking_mode" "Forces a specific bitpacking mode."
    "debug_force_commit_failure" "Force transaction commit to fail after the undo buffer has been committed. Can be used for testing commit error recovery."
    "debug_force_commit_revert_failure" "Force RevertCommit to fail while recovering from a commit failure."
    "debug_force_external" "Force out-of-core computation for operators that support it."
    "debug_force_fetch_row" "Force per-row fetching during scans."
    "debug_force_mbedtls_unsafe" "Enable mbedtls for encryption. Unsafe to use."
    "debug_force_no_cross_product" "Force disable cross product generation when the hyper graph isn't connected."
    "debug_force_update_to_del_and_insert" "Forces all updates to use the DELETE + INSERT code path instead of in-place updates."
    "debug_force_variant_shredding" "Forces the VARIANT shredding that happens during checkpointing to use the provided schema for the shredding."
    "debug_local_file_system_delay_ms" "Time to sleep before local file system open/read/write operations."
    "debug_order_verification" "Verify ORDER BY results by rewriting the ordering (NONE, CREATE_SORT_KEY or VARIANT)."
    "debug_physical_table_scan_execution_strategy" "Force the use of a given strategy for executing physical table scans."
    "debug_skip_checkpoint_on_commit" "Skip checkpointing on commit."
    "debug_verification_mode" "Toggle the verification mode."
    "debug_verification_projection" "Add internal verification projections to stress-test optimizers."
    "debug_verify_aggregate_state_export" "Enable verification of aggregate state export."
    "debug_verify_blocks" "Verify block metadata during checkpointing."
    "debug_verify_column_bindings" "Run extra internal verification of column bindings."
    "debug_verify_progress" "Verify that operators report well-formed, monotonic and complete progress during execution (NONE, LOG or ERROR)."
    "debug_verify_progress_ignore" "Comma-separated list of progress violations to ignore, as INVARIANT or INVARIANT:OPERATOR (e.g. UNSUPPORTED_SOURCE:WINDOW)."
    "debug_verify_serializer" "Verify the logical plan serializer."
    "debug_verify_statement" "Specify the type of statement verification to perform."
    "debug_verify_stats" "Verify that statistics are correct during execution."
    "debug_verify_vector" "Enable a specific type of vector verification."
    "debug_window_mode" "Switch the window mode being used."
    "default_block_size" "The default block size for new duckdb database files. New means that the file is being created and does not yet exist."
    "default_collation" "The collation setting used when none is specified."
    "default_null_order" "The NULL ordering used when none is specified (NULLS_FIRST or NULLS_LAST)."
    "default_order" "The order type used when none is specified (ASC or DESC)."
    "default_secret_storage" "Allows switching the default storage for secrets."
    "default_transaction_invalidation_policy" "When to invalidate transactions when errors occur. SYNTACTIC_ERRORS_DO_NOT_INVALIDATE means that parser and binder exceptions do not invalidate. ALL_ERRORS_INVALIDATE_TRANSACTION means all errors invalidate a transaction."
    "delim_join_as_cte" "Rewrite delim joins to materialized CTEs during dependent join flattening."
    "dialect_compatibility_mode" "Enable SQL dialect compatibility for a certain engine, e.g. `SET dialect_compatibility_mode='spark'`."
    "disable_database_invalidation" "Disables invalidating the database instance when encountering a fatal error. Should be used with great care, as DuckDB cannot guarantee correct behavior after a fatal error."
    "disable_parquet_prefetching" "parquet"
    "disable_timestamptz_casts" "Disable casting from timestamp to timestamptz."
    "disabled_compression_methods" "Disable a specific, comma-separated set of compression methods."
    "disabled_filesystems" "Disable specific file systems, thereby preventing their access, e.g. LocalFileSystem."
    "disabled_log_types" "Sets the list of disabled log types."
    "disabled_optimizers" "Disable a specific, comma-separated set of optimizers."
    "duckdb_api" "Specifies which client API/binding opened the database connection, e.g. cpp, capi, cli. The value gets folded into the HTTP User-Agent string DuckDB sends on any HTTP request."
    "ducklake_default_data_inlining_row_limit" "ducklake"
