(import ../src/db)
(use judge)

(test (with [db (db/open)]
        (db/library-version))
  "v2.0.0")

(test (with [db (db/open)]
        (db/config-flags-table))
  @{
    "__delta_only_variant_encoding_enabled" "Enables the Parquet reader to identify a Variant structurally."
    "__iceberg_unsafe_struct_null_default_interp" "iceberg"
    "access_mode" "Access mode of the database (AUTOMATIC, READ_ONLY or READ_WRITE)."
    "active_grammar_extensions" "The grammar extensions used by the parser."
    "allocator_background_threads" "Whether to enable the allocator background threads."
    "allocator_bulk_deallocation_flush_threshold" "If a bulk deallocation larger than this occurs, flush outstanding allocations."
    "allocator_flush_threshold" "Peak allocation threshold at which to flush the allocator after completing a task."
    "allow_asterisks_in_http_paths" "httpfs"
    "allow_community_extensions" "Allow loading extensions build by the community."
    "allow_extension_repositories" "Whether custom trusted extension repositories are 'allowed', 'forbidden' (which also distrusts existing repositories) or 'undecided' (the default: blocks adding new repositories, but keeps trusting existing ones). While the database is running the setting can only move from 'undecided' to 'allowed' or 'forbidden', or from 'allowed' to 'forbidden'."
    "allow_extensions_metadata_mismatch" "Allow to load extensions with no compatible metadata."
    "allow_parser_override_extension" "Allow extensions to override the current parser."
    "allow_persistent_secrets" "Allow the creation of persistent secrets that are stored and loaded on restarts."
    "allow_unredacted_secrets" "Allow printing unredacted secrets."
    "allow_unsigned_extensions" "Allow to load extensions with invalid or missing signatures."
    "allowed_configs" "List of configuration options that are ALWAYS allowed to be changed, even when lock_configuration is true."
    "allowed_directories" "List of directories, and directory prefixes, that are ALWAYS allowed to be queried, even when enable_external_access is false."
    "allowed_paths" "List of files that are ALWAYS allowed to be queried, even when enable_external_access is false."
    "approximate_join_order_threshold" "The minimum number of tables in a join to determine the optimal join order approximately instead of exactly."
    "arrow_large_buffer_size" "Whether Arrow buffers for strings, blobs, UUIDs and bits should be exported using large buffers."
    "arrow_lossless_conversion" "Whenever a DuckDB type does not have a clear native or canonical extension match in Arrow, export the types with a duckdb.type_name extension name."
    "arrow_output_list_view" "Whether the export to the Arrow format should use ListView as the physical layout for LIST columns."
    "arrow_output_version" "Whether strings should be produced by DuckDB in Utf8View format instead of Utf8."
    "asof_loop_join_threshold" "The maximum number of rows we need on the left side of an ASOF join to use a nested loop join."
    "async_threads" "The number of total async threads used by the system for tasks like I/O."
    "auto_checkpoint_skip_wal_threshold" "The estimated WAL write size at which point we will skip writing to the WAL and only checkpoint. Skipping writing to the WAL means concurrent commits are blocked while the checkpoint is happening."
    "auto_fallback_to_full_download" "httpfs"
    "autoinstall_extension_repository" "Overrides the custom endpoint for extension installation on autoloading. Falls back to custom_extension_repository, if not specified."
    "autoinstall_known_extensions" "Whether known extensions are allowed to be automatically installed when a query depends on them."
    "autoload_known_extensions" "Whether known extensions are allowed to be automatically loaded when a query depends on them."
    "aws_default_credentials" "aws"
    "aws_network_calls_via_duckdb" "aws"
    "azure_account_name" "azure"
    "azure_context_caching" "azure"
    "azure_credential_chain" "azure"
    "azure_endpoint" "azure"
    "azure_http_logging" "azure"
