    "ducklake_write_deletion_vectors" "ducklake"
    "dynamic_or_filter_threshold" "The maximum amount of OR filters that are generated dynamically from a hash join."
    "enable_caching_operators" "Enables caching operators that cache intermediate results."
    "enable_curl_server_cert_verification" "httpfs"
    "enable_external_access" "Allow the database to access external state, e.g. through loading/installing modules, COPY TO/FROM, CSV readers, pandas replacement scans, etc."
    "enable_external_file_cache" "Allow the database to cache external files like Parquet in memory."
    "enable_fsst_vectors" "Allow scans on FSST compressed segments to emit compressed vectors to utilize late decompression."
    "enable_geoparquet_conversion" "parquet"
    "enable_global_s3_configuration" "httpfs"
    "enable_http_metadata_cache" "Whether or not the global http metadata is used to cache HTTP metadata."
    "enable_legacy_parser" "legacy_parser"
    "enable_logging" "Enables the logger."
    "enable_macro_dependencies" "Enables created MACROs to create dependencies on the referenced objects, such as tables."
    "enable_object_cache" "Deprecated legacy setting, does nothing."
    "enable_optimistic_write" "Whether or not to optimistically write large appends to disk before committing. Disable this to keep bulk appends in memory, e.g. for in-memory benchmarks."
    "enable_optimizer" "Whether the query optimizer is enabled."
    "enable_profiling" "Enables profiling and sets the output format, which can be JSON, QUERY_TREE, or QUERY_TREE_OPTIMIZER."
    "enable_progress_bar" "Enables the progress bar, which prints progress to the terminal during long queries."
    "enable_progress_bar_print" "Controls the printing of the progress bar and requires 'enable_progress_bar' to be true."
    "enable_server_cert_verification" "httpfs"
    "enable_view_dependencies" "Enable created VIEWs to create dependencies on the referenced objects, such as tables."
    "enabled_log_types" "Sets the list of enabled log types."
    "error_on_division_by_zero" "Throw an error instead of returning NULL when dividing by zero."
    "errors_as_json" "Output error messages as structured JSON instead of as a raw string."
    "experimental_metadata_reuse" "EXPERIMENTAL: Re-use row group and table metadata when checkpointing."
    "explain_output" "Configure the output of EXPLAIN statements (ALL, OPTIMIZED_ONLY, PHYSICAL_ONLY)."
    "extension_directories" "Set the directories to store extensions in."
    "extension_directory" "Deprecated setting. Use extension_directories instead"
    "extension_repository_directory" "Set the directory in which trusted extension repositories are stored. This is the trust anchor for user-provided repositories, so while signature checking is enabled (allow_unsigned_extensions=false) it can only be set at startup, not while the database is running."
    "external_file_cache_local_max_block_size" "Maximum size in bytes of an external file cache block for local (non-remote) files. Larger reads are split into blocks of this size, which are fetched in parallel."
    "external_file_cache_remote_max_block_size" "Maximum size in bytes of an external file cache block for remote files (e.g. HTTP/S3). Larger reads are split into blocks of this size, which are fetched in parallel."
    "external_file_cache_remote_min_block_size" "Reads of remote files are rounded out to aligned blocks of this size, so tiny reads do not each cost a request."
    "external_file_cache_request_sizing" "How reads of cached files are sized: AUTO lets each reader choose, GRID reads the aligned blocks of the cache block size around each read, EXACT reads exactly the requested bytes. Reads of files that are not cached are always exact."
    "external_file_cache_spill" "Whether evicted external file cache blocks of remote files spill to the temporary directory instead of being dropped, so that they are re-read from there rather than re-fetched from the source."
    "external_threads" "The number of external threads that work on DuckDB tasks."
    "extra_http_headers" "httpfs"
    "file_search_path" "A comma separated list of directories to search for input files."
    "force_bitpacking_mode" "Forces a specific bitpacking mode."
    "force_column_metadata_reuse" "Force re-use of row group metadata on a column-level when checkpointing on older storage versions 6 and 7. This breaks storage backward-compatibility with older DuckDB versions."
    "force_compression" "Forces the usage of a specific compression method."
    "force_download" "httpfs"
    "force_download_threshold" "httpfs"
    "force_mbedtls_unsafe" "Enable mbedtls for encryption. Unsafe to use."
    "force_update_to_del_and_insert" "Forces all updates to use the DELETE + INSERT code path instead of in-place updates."
    "force_variant_shredding" "Forces the VARIANT shredding that happens during checkpointing to use the provided schema for the shredding."
    "fsync_mode" "How to synchronize database file changes to stable storage (STANDARD, NONE or FULL). NONE may cause database corruption after an operating system or hardware crash. FULL uses fullfsync on macOS."
    "gcs_user_project" "httpfs"
    "geometry_always_xy" "spatial"
